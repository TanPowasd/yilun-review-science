flowchart LR
  subgraph CHL["叶绿体（光合作用）"]
    direction TB
    subgraph LR1["光反应 · 类囊体薄膜"]
      W["H₂O"] -->|"光能 + 色素 + 酶<br>水的光解"| O2a["O₂"]
      W --> NADPH["NADPH"]
      ADP1["ADP + Pi"] -->|"光能"| ATP1["ATP"]
    end
    subgraph DR["暗反应 · 叶绿体基质（卡尔文循环）"]
      CO2a["CO₂"] -->|"CO₂ 的固定"| C3["2C₃"]
      C5["C₅"] --> C3
      C3 -->|"C₃ 的还原<br>消耗 ATP、NADPH"| SUG["(CH₂O) 糖类"]
      C3 -->|"再生"| C5
    end
    NADPH -->|"作还原剂"| C3
    ATP1 -->|"供能"| C3
    C3 -.->|"ADP、Pi、NADP⁺ 返回"| ADP1
  end
  subgraph RES["细胞呼吸"]
    direction TB
    G["葡萄糖"] -->|"第一阶段 · 细胞质基质<br>少量能量"| P["2 丙酮酸 + 少量 [H]"]
    P -->|"有 O₂：第二阶段 · 线粒体基质<br>+6H₂O，少量能量"| CO2b["6CO₂ + 大量 [H]"]
    CO2b -->|"第三阶段 · 线粒体内膜<br>[H] + 6O₂ → 12H₂O，大量能量"| H2O["H₂O + 大量 ATP"]
    P -->|"无 O₂ · 细胞质基质<br>不释放能量"| AN["酒精 + CO₂（酵母菌、植物）<br>或 乳酸（乳酸菌、骨骼肌）"]
  end
  SUG ==>|"有机物"| G
  O2a ==>|"O₂"| CO2b
  CO2b ==>|"CO₂"| CO2a
  H2O ==>|"H₂O"| W
