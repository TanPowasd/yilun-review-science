  classDef d fill:#e7f4e8,stroke:#2f7a45,color:#14301c
  classDef r fill:#e8f1fb,stroke:#2b5c8a,color:#132a44
  class W,O2a,NADPH,ADP1,ATP1 l
  class CO2a,C3,C5,SUG d
