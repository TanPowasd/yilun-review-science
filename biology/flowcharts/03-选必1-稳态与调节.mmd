flowchart LR
  A["选必1 稳态与调节"] --> B["内环境 = 血浆 + 组织液 + 淋巴液"]
  B --> B1["理化性质：渗透压、pH 7.35~7.45、温度"]
  B --> B2["调节网络：神经—体液—免疫"]
  A --> C["神经调节"]
  C --> C1["反射弧五部分"]
  C --> C2["静息：K⁺外流，外正内负<br/>动作：Na⁺内流，外负内正"]
  C --> C3["突触：单向传递，电→化→电"]
  A --> D["体液调节"]
  D --> D1["血糖：胰岛素降，胰高血糖素/肾上腺素升"]
  D --> D2["分级：下丘脑→垂体→腺体；负反馈"]
  D --> D3["体温、水盐（抗利尿激素）"]
  A --> E["免疫调节"]
  E --> E1["三道防线：前两道非特异性"]
  E --> E2["体液免疫：B细胞两个信号→浆细胞→抗体"]
  E --> E3["细胞免疫：细胞毒性T细胞裂解靶细胞"]
  E --> E4["失调：过敏、自身免疫病、免疫缺陷"]
  A --> F["植物激素"]
  F --> F1["生长素：极性运输；低促高抑；根>芽>茎"]
  F --> F2["赤霉素 细胞分裂素 脱落酸 乙烯"]
