flowchart LR
  A["必修1 分子与细胞"] --> B["组成细胞的分子"]
  B --> B1["元素：大量 C H O N P S K Ca Mg<br/>微量：铁猛碰新木桶"]
  B --> B2["无机物：水（自由水/结合水）、无机盐"]
  B --> B3["有机物：糖类（主要能源）、脂质（脂肪储能）<br/>蛋白质（生命活动承担者）、核酸（遗传信息携带者）"]
  A --> C["细胞结构"]
  C --> C1["细胞膜：磷脂双分子层；流动性、选择透过性"]
  C --> C2["细胞器：线粒体 叶绿体 核糖体 内质网 高尔基体 溶酶体 液泡 中心体"]
  C --> C3["细胞核：代谢和遗传的控制中心"]
  A --> D["物质进出"]
  D --> D1["被动运输：自由扩散、协助扩散"]
  D --> D2["主动运输：载体 + 能量，逆浓度"]
  D --> D3["胞吞胞吐：膜的流动性"]
  A --> E["能量代谢"]
  E --> E1["酶：降低活化能；高效、专一、温和"]
  E --> E2["ATP：直接能源 A–P~P~P"]
  E --> E3["呼吸：基质 → 线粒体基质 → 线粒体内膜"]
  E --> E4["光合：类囊体（光反应）→ 叶绿体基质（暗反应）"]
  A --> F["生命历程"]
  F --> F1["有丝分裂：间期复制，前中后末"]
  F --> F2["分化：基因选择性表达"]
  F --> F3["衰老、凋亡（基因决定）、坏死"]
